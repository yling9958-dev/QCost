# Source-only repository: everything else remains local and untracked.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-circuit.txt
!/src/
!/models/
!/tests/

/models/*
!/models/r4.pt

# Exactly one README, at the repository root.
**/[rR][eE][aA][dD][mM][eE]*
!/README.md

# Generated folders, logs, datasets and build output are never source inputs.
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/venv/
**/build/
**/dist/
**/logs/
**/log/
**/*_logs/
**/plots/
**/plot/
**/figure/
**/figures/
**/*_figures/
**/results/
**/reports/
*.py[cod]
*.so
*.o
*.a
*.dylib
*.dll
*.exe
*.idx
*.csv
*.npz
*.npy
*.parquet
*.db
*.sqlite*
*.log
*.log.*
*.out
*.err
*.stdout
*.stderr
*.trace
*.trace.*
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.svg
*.eps
*.pdf
*.zip
*.tar
*.gz
*.7z
